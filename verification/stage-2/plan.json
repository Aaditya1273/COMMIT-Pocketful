{
  "stage": "pocketful stage 2",
  "target": "stage-2",
  "specification": "pocketful/spec/stage-2.md + stage-1.md; plan/stage-2.md (R2-01..R2-28, edge cases 1-13, A2-01..A2-08) + plan/stage-1.md regression set",
  "service": { "start": "node src/server.js", "health": "/health" },
  "steps": [
    { "id": "clean-build", "kind": "build", "blocking": true, "requirements": ["R-01", "R2-28"], "timeoutMs": 600000,
      "cmd": "docker build --no-cache -t vf-pocketful-s2:verify stage-2" },
    { "id": "container", "kind": "offline", "blocking": true, "requirements": ["R-01", "R-02", "R-03", "R2-03..R2-28"], "timeoutMs": 900000,
      "cmd": "verification/stage-2/container.sh {out}/container vf-pocketful-s2:verify" },
    { "id": "official-isolated", "kind": "supplied-checks", "blocking": true, "requirements": ["R-01..R-37", "R2-01..R2-28"], "timeoutMs": 3600000,
      "report": "official/judgement.json",
      "cmd": "verification/stage-2/official.sh {out}/official . 2" },
    { "id": "shipped-stage-1-host", "kind": "supplied-checks", "blocking": true, "needsService": true, "requirements": ["R2-01"], "timeoutMs": 600000,
      "cmd": "env -u PYTHONHOME -u PYTHONPATH -C \"${COMMIT_KICKOFF:-/home/bajrangi/Wins/dark-factory-wearedevs}\" \"${COMMIT_KICKOFF:-/home/bajrangi/Wins/dark-factory-wearedevs}/.venv/bin/python\" -m pytest -p harness.plugin pocketful/test/stage_1 --base-url {url} -q -p no:cacheprovider" },
    { "id": "contract", "kind": "contract", "blocking": true, "needsService": true, "requirements": ["R2-01", "R-02..R-37"], "report": "contract.json",
      "cmd": "node verification/stage-2/contract.mjs --base-url {url} --seed 1337 --out {out}/contract.json" },
    { "id": "auth-contract", "kind": "contract", "blocking": true, "needsService": true, "requirements": ["R2-03..R2-16"], "report": "auth-contract.json",
      "cmd": "node verification/stage-2/auth-contract.mjs --base-url {url} --out {out}/auth-contract.json" },
    { "id": "upgrade", "kind": "contract", "blocking": true, "needsService": true, "requirements": ["R2-02"],
      "cmd": "verification/stage-2/upgrade-step.sh {url}" },
    { "id": "extra", "kind": "contract", "blocking": true, "needsService": true, "requirements": ["R-04", "R-13", "R-14", "R-25", "R-34", "R-35"],
      "cmd": "node verification/stage-2/extra.mjs {url}" },
    { "id": "survivor-checks", "kind": "contract", "blocking": true, "needsService": true, "requirements": ["R-04", "R-07", "R-10", "R-12", "R-19", "R-28", "R-31", "R-33", "R-35"],
      "cmd": "node verification/stage-2/survivors.mjs {url}" },
    { "id": "import-semantic", "kind": "contract", "blocking": true, "needsService": true, "requirements": ["R-33"],
      "cmd": "node verification/stage-2/import-semantic-probe.mjs {url}" },
    { "id": "ui", "kind": "contract", "blocking": true, "needsService": true, "requirements": ["R2-17..R2-28"], "report": "ui.json",
      "cmd": "env -u PYTHONHOME -u PYTHONPATH \"${COMMIT_KICKOFF:-/home/bajrangi/Wins/dark-factory-wearedevs}/.venv/bin/python\" verification/stage-2/ui_checks.py {url} --out {out}/ui.json" },
    { "id": "reference-holds-481927", "kind": "reference", "blocking": true, "needsService": true, "requirements": ["R2-04..R2-15"], "report": "reference-holds-481927/reference-report.json",
      "cmd": "node commit/campaign.ts --module verification/stage-2/reference-holds.mjs --base-url {url} --seed 481927 --operations 1000 --out {out}/reference-holds-481927" },
    { "id": "reference-holds-7", "kind": "reference", "blocking": true, "needsService": true, "requirements": ["R2-04..R2-15"], "report": "reference-holds-7/reference-report.json",
      "cmd": "node commit/campaign.ts --module verification/stage-2/reference-holds.mjs --base-url {url} --seed 7 --operations 1000 --out {out}/reference-holds-7" },
    { "id": "reference-holds-90210", "kind": "reference", "blocking": true, "needsService": true, "requirements": ["R2-04..R2-15"], "report": "reference-holds-90210/reference-report.json",
      "cmd": "node commit/campaign.ts --module verification/stage-2/reference-holds.mjs --base-url {url} --seed 90210 --operations 1000 --out {out}/reference-holds-90210" },
    { "id": "reference-stage1-481927", "kind": "reference", "blocking": true, "needsService": true, "requirements": ["R2-01", "R-12", "R-17..R-31"], "report": "reference-stage1-481927/reference-report.json",
      "cmd": "node commit/campaign.ts --module verification/stage-2/reference.mjs --base-url {url} --seed 481927 --operations 1000 --out {out}/reference-stage1-481927" },
    { "id": "reference-stage1-7", "kind": "reference", "blocking": true, "needsService": true, "requirements": ["R2-01", "R-12", "R-17..R-31"], "report": "reference-stage1-7/reference-report.json",
      "cmd": "node commit/campaign.ts --module verification/stage-2/reference.mjs --base-url {url} --seed 7 --operations 1000 --out {out}/reference-stage1-7" },
    { "id": "adversarial-holds", "kind": "adversarial", "blocking": true, "needsService": true, "requirements": ["R2-04", "R2-08", "R2-10", "R2-14", "R2-15"], "report": "adversarial-holds.json",
      "cmd": "node verification/stage-2/adversarial-holds.mjs --base-url {url} --seeds 11,23,37,51,73 --burst 50 --out {out}/adversarial-holds.json" },
    { "id": "adversarial", "kind": "adversarial", "blocking": true, "needsService": true, "requirements": ["R2-01", "R-12", "R-20", "R-25", "R-36"], "report": "adversarial.json",
      "cmd": "node verification/stage-2/adversarial.mjs --base-url {url} --seeds 11,23,37,51,73 --burst 50 --out {out}/adversarial.json" },
    { "id": "mutation-sample", "kind": "mutation", "blocking": true, "requirements": ["suite strength (100-mutant seeded sample, --max 100 --seed 1, per the owner's time constraint)"], "timeoutMs": 5400000, "report": "mutation/mutation-report.json",
      "cmd": "COMMIT_MUTANT_TIMEOUT_MS=300000 node commit/mutate.ts --target stage-2 --start 'node src/server.js' --check \"$PWD/verification/stage-2/kill.sh {url}\" --out {out}/mutation --files src --jobs 4 --max 100 --seed 1" }
  ]
}
